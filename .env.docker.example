# Vorlage für den Docker-/Self-Hosting-Betrieb (Schul-Server oder EU-Cloud).
# Kopiere diese Datei nach .env und passe Domain/Passwörter an. APP_KEY und
# Reverb-Secret können leer bleiben (werden beim ersten Start erzeugt).

APP_NAME=Schulquizz
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# mit https://, ohne / am Ende
APP_URL=https://quiz.deine-schule.de

APP_LOCALE=de
APP_FALLBACK_LOCALE=de

# --- Datenbank: MariaDB (Container "mariadb") ---
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=schulquizz
DB_USERNAME=schulquizz
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# --- Kein Redis: Queue/Cache über die Datenbank ---
QUEUE_CONNECTION=database
CACHE_STORE=database
# Sitzungen nur im (verschlüsselten) Cookie – Schülernamen landen nicht in der Datenbank.
SESSION_DRIVER=cookie

# Fehler-Logs täglich rotiert, 14 Tage
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14

# --- Broadcasting: Laravel Reverb (WebSockets) ---
BROADCAST_CONNECTION=reverb
# App-ID/Key sind öffentlich (der Browser kennt sie), das Secret nicht.
REVERB_APP_ID=schulquizz
REVERB_APP_KEY=schulquizz
# leer lassen: wird beim ersten Start zufällig erzeugt und im Storage-Volume abgelegt
REVERB_APP_SECRET=
# Server → Reverb nur INTERN im Docker-Netz (die HTTP-API /apps ist von außen gesperrt).
# Der Browser verbindet sich automatisch über die eigene Domain (Pfad /app).
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Mail: ohne SMTP verschickt "Passwort vergessen" nichts (nur Log).
# MAIL_MAILER=smtp
# MAIL_HOST=mail.deine-schule.de
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=quiz@deine-schule.de
MAIL_MAILER=log

# --- Optional: Registrierung neuer Lehrkraft-Konten absichern ---
# Nur mit diesem Code registrieren:
# REGISTRATION_CODE=lehrerzimmer
# Registrierung komplett aus:
# REGISTRATION_ENABLED=false
