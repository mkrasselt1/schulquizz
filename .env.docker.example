# Vorlage für den Docker-/Self-Hosting-Betrieb (Schul-Server oder EU-Cloud).
# Kopiere diese Datei nach .env, setze APP_KEY (php artisan key:generate) und passe
# Domain/Passwörter an.

APP_NAME=Schulquizz
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# mit https://, ohne / am Ende
APP_URL=https://quiz.deine-schule.de

APP_LOCALE=de
APP_FALLBACK_LOCALE=de

# --- Datenbank: MariaDB (Container "mariadb") ---
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=schulquizz
DB_USERNAME=schulquizz
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# --- Kein Redis: Queue/Cache/Session über die Datenbank ---
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

# --- Broadcasting: Laravel Reverb (WebSockets) ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=change-me
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me
REVERB_HOST="quiz.deine-schule.de"
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Vom Browser genutzte Reverb-Verbindung (öffentliche Adresse/TLS-Port über Reverse-Proxy)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Mail: ohne SMTP verschickt "Passwort vergessen" nichts (nur Log).
# MAIL_MAILER=smtp
# MAIL_HOST=mail.deine-schule.de
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=quiz@deine-schule.de
MAIL_MAILER=log

# --- Optional: Registrierung neuer Lehrkraft-Konten absichern ---
# Nur mit diesem Code registrieren:
# REGISTRATION_CODE=lehrerzimmer
# Registrierung komplett aus:
# REGISTRATION_ENABLED=false
