<?xml version="1.0"?>
<ruleset name="Schulquizz">
    <description>PSR-12 (Laravel-Standard) statt PEAR.</description>

    <file>app</file>
    <file>routes</file>
    <file>database</file>
    <file>tests</file>

    <arg name="colors"/>
    <arg value="p"/>

    <rule ref="PSR12"/>

    <!-- Laravel/Pint erlaubt Verkettung ohne Leerzeichen um den Punkt. -->
    <rule ref="PSR12.Operators.OperatorSpacing">
        <exclude-pattern>*</exclude-pattern>
    </rule>

    <!-- Test-Methoden nutzen snake_case (Laravel/PHPUnit-Konvention). -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!-- Zeilenlänge großzügiger (Laravel-typisch). -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>
</ruleset>
